#!/bin/bash
# tx_packets_to_virtnic
# Part of the 'virtnic' simple NIC app/driver project.
# Run this via the helper script: run_and_capture_pkt
#
# We give vnic0 an address in a subnet that nothing else on the box uses:
# 192.0.2.0/24; it's reserved for documentation and examples (RFC 5737). The
# kernel's connected route for that subnet then points only at vnic0, so a
# packet sent to 192.0.2.x lands in our driver's Tx method, and the real
# NIC's routes are left untouched.
name=$(basename "$0")
INTF=vnic0
IP_VNIC=192.0.2.1
DEST_IP_VNIC=192.0.2.2
TALKER=talker_dgram

die() {
  echo >&2 "${name}: FATAL: $*"; exit 1;
}

[[ $# -eq 1 ]] || die "Usage: ${name} number-of-packets-to-tx"

# Additional isolation - one-time:
# Don't let NM (NetworkManager) intefere with this intf
# After this running 'nmcli device status | grep vnic0' shows it as 'unmanaged'
# which is what we want...
[[ ! -f /etc/NetworkManager/conf.d/99-vnic0.conf ]] && {
   printf '[keyfile]\nunmanaged-devices=interface-name:%s\n' ${INTF} | \
      sudo tee /etc/NetworkManager/conf.d/99-vnic0.conf
   sudo systemctl reload NetworkManager
}

ip link show dev ${INTF} >/dev/null 2>&1 || die "interface ${INTF} not found (driver loaded?)"

sudo ip link set dev ${INTF} up || die "bringing ${INTF} up failed"
sudo ip addr replace ${IP_VNIC}/24 dev ${INTF} || die "assigning ${IP_VNIC} to ${INTF} failed"
ip route get ${DEST_IP_VNIC} | grep -qw "dev ${INTF}" ||
	die "packets to ${DEST_IP_VNIC} would not go out via ${INTF}; check 'ip route'"

# -B: force the rebuild, as make considers even a 0-byte binary up to date
[[ -s ${TALKER} && -x ${TALKER} ]] || make -B ${TALKER} || die "building ${TALKER} failed"

echo "${name}: running the talker process..."
./${TALKER} ${DEST_IP_VNIC} "hey, ${INTF}, wassup" "$1" || die "${TALKER} failed"
